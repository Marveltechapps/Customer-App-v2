# Local backend: match PORT in selorg-backend (default 3333). On a physical device / Expo Go, use your PC LAN IP — not localhost.
# Example: API_BASE_URL=http://192.168.1.41:3333/api/v1/customer
ENV=development
API_BASE_URL=http://localhost:3333/api/v1/customer

# EAS Project ID for Expo push notifications. Run: eas login && eas init
# Required for: order status push notifications on physical devices
EAS_PROJECT_ID=

# Google Maps API key (Maps SDK for Android/iOS, Directions API, Geocoding). Get from Google Cloud Console.
# Required for: RouteMap, MapAddressPin, order tracking. Run `expo prebuild --clean` after setting.
GOOGLE_MAPS_API_KEY=AIza...
API_VERSION=/api/v1

# -----------------------------------------------------------------------------
# Firebase (JS SDK) — required for Analytics/Auth/etc. No hardcoded values in app code.
# Copy values from Firebase Console → Project settings → Your apps.
# For EAS Build: set the same names as EAS Secrets (or EXPO_PUBLIC_* equivalents).
# Android package: com.selorg.com  |  iOS bundle: com.selorg.com
# Native FCM: google-services.json (Android) + GoogleService-Info.plist (iOS) at app root.
# iOS also needs @react-native-firebase/app + messaging, APNs Auth Key (.p8) uploaded in Firebase Console.
# APNs Auth Key (Firebase Console → Cloud Messaging → Apple):
#   Key ID: 2HVKPR57YW
#   Team ID: 387A8ZCB5C
#   Bundle: com.selorg.com
# Optional overrides (defaults match above; also set in eas.json per profile):
# APPLE_TEAM_ID=387A8ZCB5C
# APNS_KEY_ID=2HVKPR57YW
# APS_ENVIRONMENT=production
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Shared app ID, or set platform-specific IDs below
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=
# Optional (Google Analytics)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Aliases accepted by app.config.js (useful for EAS Secrets without EXPO_PUBLIC_ prefix):
# FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, FIREBASE_PROJECT_ID, FIREBASE_STORAGE_BUCKET,
# FIREBASE_MESSAGING_SENDER_ID, FIREBASE_APP_ID, FIREBASE_APP_ID_ANDROID, FIREBASE_APP_ID_IOS,
# FIREBASE_MEASUREMENT_ID
